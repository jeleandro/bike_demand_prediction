import numpy as np
from dataclasses import dataclass
from typing import Optional, Literal, Tuple, List

from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.preprocessing import KBinsDiscretizer, LabelEncoder


def _chi2_two_rows(row1: np.ndarray, row2: np.ndarray) -> float:
    """
    Chi-square statistic for a 2 x K contingency table:
    rows are row1 and row2 (counts per class). Columns are classes.
    """
    r1 = row1.astype(float, copy=False)
    r2 = row2.astype(float, copy=False)
    col = r1 + r2
    total = col.sum()
    if total == 0:
        return 0.0

    r1_sum = r1.sum()
    r2_sum = r2.sum()

    # Expected counts under independence
    # E_1k = r1_sum * (col_k / total); E_2k = r2_sum * (col_k / total)
    with np.errstate(divide="ignore", invalid="ignore"):
        p = col / total
        e1 = r1_sum * p
        e2 = r2_sum * p
        # Safe χ²: ignore columns where expected is (near) zero
        mask = (e1 > 1e-12) & (e2 > 1e-12)
        num = (r1[mask] - e1[mask]) ** 2 / e1[mask] + (r2[mask] - e2[mask]) ** 2 / e2[mask]
        return float(np.sum(num))


def _chi2_critical_wilson_hilferty(df: int, alpha: float) -> float:
    """
    Approximate χ² critical value using Wilson–Hilferty transform:
      X ~ χ²(df)  =>  (X/df)^{1/3} ≈ N(1 - 2/(9df), 2/(9df))
    We need q such that P(X >= q) = alpha  =>  q = Q_{1-alpha}.
    """
    from statistics import NormalDist
    if df <= 0:
        return 0.0
    z = NormalDist().inv_cdf(1 - alpha)  # z_{1-alpha}
    a = 2.0 / (9.0 * df)
    term = 1 - a + z * np.sqrt(a)
    return df * (term ** 3)


@dataclass
class ChiMergeQuantileDiscretizer(BaseEstimator, TransformerMixin):
    """
    A supervised discretizer:
      1) start with quantile bins
      2) iteratively merge adjacent bins using ChiMerge (lowest 2xK χ²)
    Parameters
    ----------
    n_init_bins : int
        Number of initial quantile bins.
    max_bins : Optional[int]
        Stop merging once number of bins <= max_bins.
        If None and alpha is None, no merging occurs.
    alpha : Optional[float]
        If provided (e.g., 0.05), also stop when all adjacent χ² >= χ²_crit(df=K-1, alpha).
        Uses Wilson–Hilferty approximation (no SciPy required).
    encode : {"ordinal", "onehot"}
        Output encoding in transform().
    dtype : data type of output.
    """
    n_init_bins: int = 20
    max_bins: Optional[int] = 5
    alpha: Optional[float] = None
    encode: Literal["ordinal", "onehot"] = "ordinal"
    dtype: type = np.float64
    # ---- learned attributes ----
    bin_edges_: Optional[np.ndarray] = None          # initial quantile edges (from KBins)
    merged_edges_: Optional[np.ndarray] = None       # final edges after merging (length = n_bins+1)
    classes_: Optional[np.ndarray] = None            # label-encoded class values
    n_classes_: Optional[int] = None
    label_encoder_: Optional[LabelEncoder] = None
    kbins_: Optional[KBinsDiscretizer] = None
    # diagnostics
    chi2_history_: Optional[List[Tuple[int, float]]] = None  # (num_bins_after_merge, min_chi2)

    def fit(self, X, y):
        X = self._validate_X(X)
        y = self._validate_y(y)
        n_samples = X.shape[0]
        if y.shape[0] != n_samples:
            raise ValueError("X and y must have the same number of samples.")

        # 1) Initial quantile bins (unsupervised)
        self.kbins_ = KBinsDiscretizer(
            n_bins=self.n_init_bins, encode="ordinal", strategy="quantile"
        )
        # KBinsDiscretizer expects 2D; we already have that
        self.kbins_.fit(X)

        # bin indices for each sample (0..n_init_bins-1)
        init_bin_idx = self.kbins_.transform(X).astype(int).ravel()
        n_bins_current = int(self.kbins_.n_bins_[0])

        # Initial edges (length n_bins+1)
        self.bin_edges_ = np.asarray(self.kbins_.bin_edges_[0], dtype=float)

        # 2) Supervised counts per (bin, class)
        self.label_encoder_ = LabelEncoder().fit(y)
        y_enc = self.label_encoder_.transform(y)
        self.classes_ = self.label_encoder_.classes_
        self.n_classes_ = len(self.classes_)

        counts = np.zeros((n_bins_current, self.n_classes_), dtype=float)
        for b, c in zip(init_bin_idx, y_enc):
            counts[b, c] += 1.0

        # 3) Iterative ChiMerge merging
        edges = self.bin_edges_.copy()
        self.chi2_history_ = []

        while True:
            if counts.shape[0] <= 1:
                break

            # compute 2xK chi2 for adjacent pairs
            chi2_vals = []
            for i in range(counts.shape[0] - 1):
                chi2_vals.append(_chi2_two_rows(counts[i], counts[i + 1]))
            chi2_vals = np.asarray(chi2_vals)

            # stopping conditions
            stop_by_max_bins = (self.max_bins is not None) and (counts.shape[0] <= self.max_bins)
            if self.alpha is not None:
                df = max(1, self.n_classes_ - 1)
                chi2_crit = _chi2_critical_wilson_hilferty(df, self.alpha)
                stop_by_alpha = np.all(chi2_vals >= chi2_crit)
            else:
                stop_by_alpha = True  # not using alpha; so doesn't force merging

            if stop_by_max_bins and stop_by_alpha:
                break

            # find the smallest chi2 pair to merge
            j = int(np.argmin(chi2_vals))
            min_chi2 = chi2_vals[j]
            self.chi2_history_.append((counts.shape[0] - 1, float(min_chi2)))

            # merge bins j and j+1
            counts[j, :] += counts[j + 1, :]
            counts = np.delete(counts, j + 1, axis=0)

            # merge edges: remove the interior boundary at index j+1
            edges = np.delete(edges, j + 1)

            # optional early stop if neither rule is set
            if self.max_bins is None and self.alpha is None:
                break

        self.merged_edges_ = edges
        return self

    def transform(self, X):
        if self.merged_edges_ is None:
            raise RuntimeError("The transformer is not fitted yet.")
        X = self._validate_X(X, fitting=False)
        # map into final bins using merged edges (right-open except last)
        bin_idx = np.searchsorted(self.merged_edges_[1:-1], X.ravel(), side="right")
        # bin_idx in [0, n_bins-1]
        if self.encode == "ordinal":
            return bin_idx.astype(self.dtype).reshape(-1, 1)
        elif self.encode == "onehot":
            n_bins = len(self.merged_edges_) - 1
            out = np.zeros((bin_idx.size, n_bins), dtype=self.dtype)
            out[np.arange(bin_idx.size), bin_idx] = 1.0
            return out
        else:
            raise ValueError("encode must be 'ordinal' or 'onehot'")

    # ---------- helpers ----------
    def _validate_X(self, X, fitting=True):
        X = np.asarray(X)
        if X.ndim == 1:
            X = X.reshape(-1, 1)
        if X.ndim != 2 or X.shape[1] != 1:
            raise ValueError("X must be array-like with shape (n_samples,) or (n_samples, 1).")
        if fitting and np.isnan(X).any():
            raise ValueError("NaNs in X are not supported.")
        return X

    def _validate_y(self, y):
        if y is None:
            raise ValueError("y (class labels) is required for ChiMerge.")
        y = np.asarray(y)
        if y.ndim != 1:
            raise ValueError("y must be 1D.")
        return y

    # nice-to-have APIs
    @property
    def n_bins_(self) -> int:
        if self.merged_edges_ is None:
            raise AttributeError("Not fitted.")
        return len(self.merged_edges_) - 1

    def get_intervals(self) -> List[Tuple[float, float]]:
        """Return the final closed-open intervals [(left, right), ...], last right is inclusive."""
        if self.merged_edges_ is None:
            raise RuntimeError("Not fitted.")
        edges = self.merged_edges_
        intervals = [(edges[i], edges[i + 1]) for i in range(len(edges) - 1)]
        return intervals

    def fit_transform(self, X, y):
        return self.fit(X, y).transform(X)
